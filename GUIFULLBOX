--==================================================
-- OPEN BOX
--==================================================

local opening = false

local function OpenBox(box)

    if opening then
        status.Text = "Đang xử lý..."
        return
    end

    opening = true

    status.Text =
        "Đang mở: "
        .. box.Name
        .. " | "
        .. currency

    local success, result = pcall(function()

        return Shop.OpenCrate:InvokeServer(
            box.ID,
            "MysteryBox",
            currency
        )

    end)

    if success then

        if result then

            print("BOX:", box.ID)
            print("CURRENCY:", currency)
            print("RESULT:", result)

            status.Text =
                "Nhận được: "
                .. tostring(result)

        else

            status.Text =
                "Không thể mở hoặc không đủ currency"

        end

    else

        warn("OPEN ERROR:", result)

        status.Text = "Lỗi: " .. tostring(result)

    end

    opening = false

end

